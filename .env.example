# Copy this file to .env and fill in the values. .env is gitignored; never commit real keys.

# Required. Gemini API key, used by cli.py and api/main.py.
GOOGLE_API_KEY=

# Optional. Leave both empty to disable Langfuse tracing (agent/observability.py turns it off automatically).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region your keys belong to. The EU default (https://cloud.langfuse.com) returns 401
# for some newer accounts; the US region is https://us.cloud.langfuse.com. Check the Langfuse project settings.
LANGFUSE_HOST=

# Not used by the current code (the provider decision settled on Gemini; see PROGRESS.md). Kept for reference
# in case langchain-groq is used again.
GROQ_API_KEY=
